# Copy to .env (never commit .env). Everything here is optional.

# Port and interface. 0.0.0.0 lets your other devices on the same Wi-Fi reach this home hub.
PORT=3000
HOST=0.0.0.0

# Natural voice for replies spoken at the door (ElevenLabs). Without a key, the device voice is used.
ELEVENLABS_API_KEY=
# Optional: a voice from your ElevenLabs voice library (default: a stock voice)
ELEVENLABS_VOICE_ID=
# Optional: model id (default: eleven_flash_v2_5, the low-latency model)
ELEVENLABS_MODEL_ID=

# Optional: a name for this hub, shown on the other devices (default: the computer's name)
HARK_HUB_NAME=
# Optional: extra web origins allowed to use this hub (comma-separated), e.g. a copy of the app on your own site
HARK_ALLOWED_ORIGINS=
# Optional: other names this hub may be reached at (comma-separated), e.g. a public name it is hosted under.
# Home-network addresses (IP addresses, localhost, name.local, single-word names) always work.
HARK_ALLOWED_HOSTS=
# Optional: where the hub keeps its random id (default: ~/.hark)
HARK_DATA_DIR=
